# --- API server (server/.env) ---
IMAGE_BUCKET=example-smartimg-images
IMAGE_BUCKET_REGION=ap-northeast-2
IMAGE_API_TOKEN=change-me-in-production
MAX_UPLOAD_BYTES=10485760
PRESIGN_TTL_SECONDS=900
# Cache lifetime for path-mirrored keys, which are overwritten when the
# source file changes. Other keys are immutable and cached for a year.
MUTABLE_MAX_AGE_SECONDS=60
# Set MOCK_S3=true to run the whole app locally without AWS (dev only)
MOCK_S3=false
MOCK_CORS_ORIGIN=http://localhost:5173

# --- Web app (web/.env.local, build-time) ---
VITE_IMAGE_CDN_URL=https://d1234example.cloudfront.net
VITE_IMAGE_API_TOKEN=change-me-in-production
